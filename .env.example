# Server-side Gemini credential. Keep the real value private.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Public Firebase web-app configuration (embedded in the client bundle at build time).
# Restrict the Firebase API key in Google Cloud to the required APIs and approved origins.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id
VITE_FIREBASE_MEASUREMENT_ID=

# Optional deployed application URL.
APP_URL=http://localhost:3000
